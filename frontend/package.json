{
  "name": "arya-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:widget": "vite --config vite.config.widget.js",
    "build": "npm run build:app && npm run build:widget && npm run build:loader",
    "build:app": "vite build",
    "build:widget": "vite build --config vite.config.widget.js",
    "build:loader": "vite build --config vite.config.loader.js",
    "preview": "vite preview",
    "test": "node --test src/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@livekit/components-react": "^2.9.0",
    "livekit-client": "^2.13.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
