# ─── Arya infrastructure config ─────────────────────────────────────────
# Secrets are NOT stored in this repo. Generate them once with:
#
#   ./scripts/init.sh
#
# which writes .env, livekit.yaml, seaweedfs-s3.json, and backend/.env.local
# (all gitignored). After that, `docker compose up` works. All AI provider
# keys (OpenAI / Groq / SerpAPI / Mem0) are entered in the browser UI at
# http://localhost:8000 — never here.
#
# This file documents the variables; copy values into .env only if you want
# to set them by hand instead of running the script.

# LiveKit (self-hosted). The key/secret pair must match livekit.yaml.
# Generate a secret with: openssl rand -base64 32
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=<generated-by-init.sh>
LIVEKIT_API_SECRET=<generated-by-init.sh>

# Postgres (conversations, messages, knowledge-base ingest queue, catalogs).
# Compose builds DATABASE_URL from this; rotating it on an EXISTING volume
# also needs: docker compose exec postgres psql -U arya -d arya \
#   -c "ALTER USER arya WITH PASSWORD '<new>';"
POSTGRES_PASSWORD=<generated-by-init.sh>

# SeaweedFS S3 (uploaded knowledge-base documents). Must match
# seaweedfs-s3.json.
S3_ACCESS_KEY=<generated-by-init.sh>
S3_SECRET_KEY=<generated-by-init.sh>

# Widget visitor identity. The api signs a per-browser token with this
# (backend/src/visitors.py); the widget sends it back on every call so the
# agent's memory follows that browser, and nobody can pick another visitor's
# identity. Unset on an install that never re-ran init.sh: derived from
# LIVEKIT_API_SECRET so tokens stay stable across restarts. Rotating it
# turns every widget visitor into a new person (old memories orphaned).
ARYA_VISITOR_SECRET=<generated-by-init.sh>
# Shared by api and arya-whatsapp: a session request carrying it may name a
# WhatsApp customer (channel + phone). Without it those fields are ignored
# and the caller is an anonymous widget visitor. Same LIVEKIT_API_SECRET
# fallback when unset, on both services.
ARYA_BRIDGE_TOKEN=<generated-by-init.sh>

# ── non-secret endpoints (defaults work; override only if relocated) ────────
# QDRANT_URL=http://localhost:6333
# OLLAMA_URL=http://localhost:11434
# EMBEDDINGS_URL=http://localhost:11434 # RAG embeddings (nomic profile); defaults
#                                # to OLLAMA_URL — set it to keep embeddings on
#                                # the bundled Ollama when OLLAMA_URL is repointed
# SPEACHES_URL=http://localhost:8010     # Whisper STT + Kokoro TTS (Speaches)
# ARYA_MCP_URL=http://localhost:8020     # arya-mcp sidecar: the MCP servers Arya
#                                # hosts itself (read-only Postgres connector).
#                                # Compose sets it per service; only override for
#                                # a source run with the sidecar somewhere else.
# S3_ENDPOINT=localhost:8333
# S3_BUCKET=arya-docs
# S3_SECURE=false                # true for any TLS S3 endpoint (real S3/R2)

# ── deployment ───────────────────────────────────────────────────────────────
# ARYA_RUNTIME_ONLY=1             # engine-only mode: widget + public API, no
#                                 # builder UI. Requires ARYA_ADMIN_TOKEN
#                                 # (refuses to boot without it). Agents are
#                                 # pushed to an engine from a local builder.
# PUBLIC_BASE_URL=                # public URL of this deployment (e.g.
#                                 # https://1.2.3.4.sslip.io) — used to
#                                 # generate share links + embed snippets,
#                                 # and as the base of the connector OAuth
#                                 # redirect URI (/api/connections/oauth/callback).
# ARYA_WEBHOOK_BASE_URL=          # public origin that reaches the WhatsApp
#                                 # bridge (arya-whatsapp, 127.0.0.1:8030).
#                                 # A tunnel locally, or the proxy that
#                                 # already fronts the API in production.
#                                 # Shown on Publish as the callback URL to
#                                 # paste into Meta. Defaults to
#                                 # PUBLIC_BASE_URL when unset.
# GOOGLE_OAUTH_CLIENT_ID=         # Google Calendar connector: the OAuth app
# GOOGLE_OAUTH_CLIENT_SECRET=     # (client id + secret). Entering them in the
#                                 # Options UI is the normal path; env is the
#                                 # fallback, same as provider keys.
# ARYA_AGENT_NAME=arya            # explicit-dispatch name (default arya); must
#                                 # match on api AND agent-worker. Set to "" on
#                                 # both to restore auto-dispatch (CLI rooms).
# ARYA_ADMIN_TOKEN=               # set on any PUBLIC deployment: locks the
#                                 # builder API behind this token (the UI asks
#                                 # for it once). Unset = open, local-use mode.
#                                 # Generate one: openssl rand -hex 24

# ── tuning knobs (defaults are fine locally) ────────────────────────────────
# LIVEKIT_EMPTY_TIMEOUT_S=120    # empty room auto-close
# S3_PRESIGN_TTL_MIN=15          # presigned-upload URL lifetime
# INGEST_POLL_S=2                # ingestion queue poll interval
# DB_POOL_MIN=1
# DB_POOL_MAX=5
# LOCAL_STT_TIMEOUT_S=60         # local-provider per-request timeouts
# LOCAL_LLM_TIMEOUT_S=90         #   (raise on slow CPUs, lower on GPUs)
# LOCAL_TTS_TIMEOUT_S=60
# OPENAI_STT_REALTIME=1          # openai provider transcribes over the realtime
#                                # websocket while the caller speaks (interim
#                                # captions, no post-utterance round trip). Set 0
#                                # to fall back to batch transcription; per agent,
#                                # stt.realtime=false does the same. Realtime
#                                # bills the whole audio stream, silence included.

# Extra CORS origins for the API, comma-separated (Vite dev server is
# already allowed)
CORS_ORIGINS=

# Worker-wide fallback for the built-in order desk (demo/shop). The normal
# route is per agent: attach the shop database as a Postgres connector on
# Options and the desk uses it. Set this only for an install without the
# connector. Empty: the desk answers from its fake data.
# scripts/seed_demo_shop.sh creates the database and prints the string.
# ARYA_SHOP_DSN=postgresql://shop_agent:PASSWORD@localhost:5432/shopdemo
